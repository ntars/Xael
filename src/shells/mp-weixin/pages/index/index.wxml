<!-- pages/index/index.wxml —— 五视图单页壳（首页/结果/关于/关于我们/详情） -->
<view class="nt-page {{dark ? 'nt-dark' : ''}}">
  <!-- 开屏 -->
  <view class="nt-splash {{splash ? '' : 'nt-splash-out'}}" wx:if="{{splash}}">
    <view class="nt-splash-inner">
      <image class="nt-splash-logo" src="/static/logo.png" mode="aspectFit" />
      <view class="nt-splash-name">玄玖灵犀</view>
      <view class="nt-splash-slogan">演乾坤 · 知天命</view>
    </view>
  </view>

  <!-- 首页 -->
  <view class="nt-view" wx:if="{{view === 'home'}}">
    <view class="nt-top">
      <text class="nt-btn-text" bindtap="goAbout">关于</text>
    </view>

    <!-- 空态（无结果时） -->
    <view class="nt-home-empty" wx:if="{{!result}}">
      <image class="nt-home-logo" src="/static/logo.png" mode="aspectFit" />
      <view class="nt-home-name">玄玖灵犀</view>
      <view class="nt-search">
        <view class="nt-halo"></view>
        <input class="nt-search-input" value="{{query}}" placeholder="{{placeholder}}" confirm-type="search" bindinput="onInput" bindconfirm="onSearch" />
      </view>
      <text class="nt-disclaimer">{{disclaimer}}</text>
    </view>

    <!-- 结果 -->
    <view class="nt-result" wx:if="{{result}}">
      <block wx:for="{{result.sections}}" wx:key="title" wx:for-item="sec">
        <view class="nt-result-title">{{sec.title}}</view>
        <view class="nt-result-lead" wx:if="{{sec.lead}}">{{sec.lead}}</view>
        <view class="nt-block" wx:for="{{sec.blocks}}" wx:key="title" wx:for-item="blk">
          <view class="nt-block-title">{{blk.title}}</view>
          <view class="nt-row {{row.pair ? '' : 'nt-row-full'}}" wx:for="{{blk.rows}}" wx:key="label" wx:for-item="row">
            <text class="nt-row-label">{{row.label}}</text>
            <text class="nt-row-value">{{row.value}}</text>
          </view>
        </view>
      </block>
      <view class="nt-search nt-search-inline">
        <input class="nt-search-input" value="{{query}}" placeholder="{{placeholder}}" confirm-type="search" bindinput="onInput" bindconfirm="onSearch" />
      </view>
    </view>

    <view class="nt-footer">
      <text>{{footer.icp}}</text>
      <text>{{footer.copyright}}</text>
    </view>
  </view>

  <!-- 关于页 -->
  <view class="nt-view" wx:if="{{view === 'about'}}">
    <view class="nt-page-head">
      <text class="nt-btn-back" bindtap="goHome">‹</text>
      <view class="nt-page-title">关于</view>
    </view>
    <view class="nt-cards">
      <view class="nt-card {{item.danger ? 'nt-card-danger' : ''}}" wx:for="{{aboutCards}}" wx:key="id" data-id="{{item.id}}" bindtap="onAboutCard">
        <text>{{item.label}}</text>
        <text class="nt-card-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 关于我们 -->
  <view class="nt-view" wx:if="{{view === 'studio'}}">
    <view class="nt-page-head">
      <text class="nt-btn-back" bindtap="goAbout">‹</text>
      <view class="nt-page-title">关于我们</view>
    </view>
    <view class="nt-cards">
      <view class="nt-card" wx:for="{{studioCards}}" wx:key="id" data-id="{{item.id}}" bindtap="onStudioCard">
        <text>{{item.label}}</text>
        <text class="nt-card-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 详情页 -->
  <view class="nt-view" wx:if="{{view === 'doc' && doc}}">
    <view class="nt-page-head">
      <text class="nt-btn-back" bindtap="goAbout">‹</text>
      <view class="nt-page-title">{{doc.title}}</view>
    </view>
    <view class="nt-doc-body">
      <view class="nt-doc-p" wx:for="{{doc.body}}" wx:key="*this">{{item}}</view>
    </view>
  </view>

  <!-- 弹窗 -->
  <view class="nt-modal" wx:if="{{modal.show}}">
    <view class="nt-modal-mask" bindtap="closeModal"></view>
    <view class="nt-modal-card">
      <view class="nt-modal-text">{{modal.text}}</view>
      <view class="nt-modal-actions">
        <view class="nt-modal-btn" bindtap="closeModal">取消</view>
        <view class="nt-modal-btn {{modal.danger ? 'nt-modal-danger' : ''}}" bindtap="onModalOk">确认</view>
      </view>
    </view>
  </view>
</view>
